{
  "name": "signed-commits",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main",
        "refs/heads/0.1.x",
        "refs/heads/1.0.0",
        "refs/heads/1.1.0",
        "refs/heads/1.x.x"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_signatures"
    }
  ]
}
